# ───────── To see a first video you need NO keys at all ─────────
# Free path: step 1 skipped (content JSON already exists), no AI images (emoji are used),
# free narration (edge), rough lyric timing if stable-ts isn't installed, no upload.

# Step 1 — script/lyrics. Choose one provider.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Step 2 — AI illustrations (optional; skipped when empty)
OPENAI_API_KEY=
# cheapest: gpt-image-1-mini · higher quality: gpt-image-1.5 (gpt-image-1 retires 2026-10-23)
IMAGE_MODEL=gpt-image-1-mini

# Step 3 — narration: edge (free) | kokoro (free, offline) | elevenlabs (paid) | none
TTS_PROVIDER=edge
# edge voices: en-US-AnaNeural (child), en-US-JennyNeural · kokoro voices: af_heart, af_bella
TTS_VOICE=en-US-AnaNeural
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Step 4 — lyric alignment (optional: pip install -U stable-ts; otherwise rough timing)
# auto = try stable-ts, fall back to the vocals stem · vocals = always use the vocals stem (no Whisper)
ALIGNER=auto
WHISPER_MODEL=small
PYTHON=python3
# rough timing only — seconds of music before the singing starts / after it ends
# SONG_INTRO=6
# SONG_OUTRO=4

# Step 6 — YouTube upload (optional, only runs with --upload)
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# Optional: use an existing Chrome/Chromium instead of Remotion's download
# REMOTION_BROWSER=
